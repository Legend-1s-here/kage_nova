# KAGENOVA Environment Configuration
# Copy this file to .env.local for local development. Do NOT commit .env.local to git.

# MongoDB connection string (e.g., MongoDB Atlas free tier or local instance)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/kagenova?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/kagenova?retryWrites=true&w=majority

# Secret key used for signing group session JWT cookies
# Generate a strong 32+ character string (e.g. using `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_min_32_chars

# Optional: Port configuration (defaults to 3000)
PORT=3000
